{
  "name": "headsup-desktop",
  "productName": "HeadsUp",
  "version": "1.1.0",
  "description": "수업 중 랜덤한 순간에 교수님을 볼 타이밍을 알려 주는 배너 앱",
  "main": "main.js",
  "author": "hila38295-hub",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.headsup.desktop",
    "productName": "HeadsUp",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "고개 들어!",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "HeadsUp-Setup.exe"
    }
  }
}
