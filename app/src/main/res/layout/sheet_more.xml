<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="더보기"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/Label"
        android:layout_marginTop="18dp"
        android:text="테마" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/themeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeLight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="라이트" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeDark"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="다크" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeSystem"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="시스템" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/Label"
        android:layout_marginTop="22dp"
        android:text="문의" />

    <TextView
        android:id="@+id/tvContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="아래 버튼으로 기기 정보를 복사해서 같이 보내 주면 버그를 더 빨리 고칠 수 있어요."
        android:textColor="@color/ink_sub"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyInfo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="기기 정보 복사" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuide"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="사용법 다시 보기" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:textColor="@color/ink_sub"
        android:textSize="12sp" />
</LinearLayout>
