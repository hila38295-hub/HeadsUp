<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/cpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_stage"
            android:padding="16dp">

            <TextView
                android:id="@+id/cpPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:minWidth="200dp"
                android:paddingStart="24dp"
                android:paddingTop="14dp"
                android:paddingEnd="24dp"
                android:paddingBottom="14dp"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/cpWarn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="⚠️ 글자와 배경이 비슷해서 잘 안 보일 수 있어요"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/Label"
            android:text="기본 색" />

        <GridLayout
            android:id="@+id/cpGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="직접 고르기"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cpHex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView style="@style/SliderLabel" android:text="색상" />
        <com.google.android.material.slider.Slider
            android:id="@+id/cpHue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="360" />

        <TextView style="@style/SliderLabel" android:text="채도" />
        <com.google.android.material.slider.Slider
            android:id="@+id/cpSat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView style="@style/SliderLabel" android:text="밝기" />
        <com.google.android.material.slider.Slider
            android:id="@+id/cpVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cpDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="완료" />
    </LinearLayout>
</ScrollView>
